DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB"
AUTH_SECRET="genera-un-secreto-largo"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STORAGE_DIR="./storage"
# Flow.cl (sandbox por defecto). Sin claves, el checkout solo ofrece transferencia.
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_API_URL="https://sandbox.flow.cl/api"
# SMTP opcional para correos de pedido
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tío Wheels <contacto@tiowheels.cl>"
# Analítica opcional (sin estas variables no se carga ningún script de terceros)
# Meta Pixel: el sitio anterior usaba el píxel 1339077757161490
# NEXT_PUBLIC_META_PIXEL_ID="1339077757161490"
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Analytics 4 (ID de medición, ej. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Cloudflare R2 (imágenes en producción). Sin estas variables se usan archivos locales en STORAGE_DIR.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tiowheels-media"
# Dominio público del bucket (custom domain o el r2.dev). Se fija en build (NEXT_PUBLIC_*).
NEXT_PUBLIC_MEDIA_BASE_URL=""
